_G.MontanaSafeList = _G.MontanaSafeList or {}

local BbEspNameOn = false
local BbEspHealthOn = false
local BbEspDistOn = false
local BbEspHighlightOn = false

local BbEspEntries = {}
local BbEspHighlights = {}

local function BbEspIsSafe(name)
    name = string.lower(tostring(name or ''))

    for _, pattern in ipairs(_G.MontanaSafeList) do
        if pattern ~= '' and string.find(name, string.lower(pattern), 1, true) then
            return true
        end
    end

    return false
end

local function BbEspCreate(player)
    if BbEspEntries[player] then
        return
    end

    local nameLabel = Drawing.new('Text')

    nameLabel.Size = 16
    nameLabel.Center = true
    nameLabel.Outline = true
    nameLabel.Color = BbEspIsSafe(player.Name) and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 255, 255)
    nameLabel.Font = 4

    local distLabel = Drawing.new('Text')

    distLabel.Size = 14
    distLabel.Center = true
    distLabel.Outline = true
    distLabel.Color = Color3.fromRGB(255, 255, 255)
    distLabel.Font = 4

    local hpBack = Drawing.new('Square')

    hpBack.Filled = false
    hpBack.Thickness = 1
    hpBack.Color = Color3.fromRGB(0, 0, 0)
    hpBack.Transparency = 0.9
    hpBack.Visible = false

    local hpFill = Drawing.new('Square')

    hpFill.Filled = true
    hpFill.Transparency = 0.9
    hpFill.Visible = false

    local drawings = { nameLabel, distLabel, hpBack, hpFill }

    local conn

    conn = BbEspRunService.RenderStepped:Connect(function()
        if not player or not player.Character or not player.Character:FindFirstChild('HumanoidRootPart') then
            for _, d in ipairs(drawings) do
                d.Visible = false
            end

            return
        end

        local camera = workspace.CurrentCamera

        if not camera then
            return
        end

        local rootPart = player.Character.HumanoidRootPart
        local humanoid = player.Character:FindFirstChild('Humanoid')
        local distance = 0

        if BbEspLocal.Character and BbEspLocal.Character:FindFirstChild('HumanoidRootPart') then
            distance = (rootPart.Position - BbEspLocal.Character.HumanoidRootPart.Position).Magnitude
        end

        local pos, onScreen = camera:WorldToViewportPoint(rootPart.Position)

        if not onScreen or pos.Z <= 0 then
            for _, d in ipairs(drawings) do
                d.Visible = false
            end

            return
        end

        local x = pos.X
        local y = pos.Y - 15

        if BbEspHealthOn and humanoid and humanoid.Health > 0 then
            local pct = humanoid.Health / (humanoid.MaxHealth > 0 and humanoid.MaxHealth or 1)
            local h = 4
            local w = 60
            local bx = x - w / 2

            hpBack.Position = Vector2.new(bx, y - h - 2)
            hpBack.Size = Vector2.new(w, h)
            hpBack.Visible = true

            hpFill.Position = Vector2.new(bx, y - h - 2)
            hpFill.Size = Vector2.new(w * pct, h)
            hpFill.Color = Color3.fromHSV(pct * 0.333, 0.8, 0.9)
            hpFill.Visible = true

            y = y - h - 6
        else
            hpBack.Visible = false
            hpFill.Visible = false
        end

        if BbEspNameOn then
            local minSize, maxSize = 14, 42
            local alpha = math.clamp(distance / 50, 0, 1)
            local size = maxSize - (maxSize - minSize) * alpha

            nameLabel.Text = player.Name
            nameLabel.Size = math.floor(size)
            nameLabel.Color = BbEspIsSafe(player.Name) and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 255, 255)
            nameLabel.Outline = true
            nameLabel.Position = Vector2.new(x, y - 16)
            nameLabel.Visible = true
        else
            nameLabel.Visible = false
        end

        distLabel.Text = BbEspDistOn and string.format('%.0f studs', distance) or ''
        distLabel.Position = Vector2.new(x, pos.Y + 20)
        distLabel.Visible = BbEspDistOn
    end)

    BbEspEntries[player] = { conn = conn, drawings = drawings }
end

local function BbEspDestroy(player)
    local entry = BbEspEntries[player]

    if entry then
        if entry.conn then
            pcall(function()
                entry.conn:Disconnect()
            end)
        end

        for _, d in ipairs(entry.drawings) do
            if d and d.Destroy then
                pcall(function()
                    d:Destroy()
                end)
            elseif typeof(d) == 'table' and d.Visible ~= nil then
                d.Visible = false
            end
        end

        BbEspEntries[player] = nil
    end
end

local function BbEspUpdateHighlight(player)
    if player == BbEspLocal or not player.Character then
        return
    end

    if BbEspHighlights[player] then
        BbEspHighlights[player]:Destroy()
        BbEspHighlights[player] = nil
    end

    if BbEspHighlightOn then
        local highlight = Instance.new('Highlight')

        highlight.Name = 'PlayerHighlight'
        highlight.Adornee = player.Character
        highlight.FillColor = Color3.fromRGB(136, 0, 153)
        highlight.OutlineColor = Color3.fromRGB(136, 0, 153)
        highlight.Parent = workspace

        BbEspHighlights[player] = highlight
    end
end

local function BbEspLoad()
    for _, player in ipairs(BbEspPlayers:GetPlayers()) do
        if player ~= BbEspLocal and not BbEspEntries[player] then
            BbEspCreate(player)
        end
    end
end

