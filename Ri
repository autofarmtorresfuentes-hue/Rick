local function GhostUpdateSwitch()
    if not GhostSwitchBg or not GhostSwitchThumb then
        return
    end

    FloatTween:Create(GhostSwitchBg, TweenInfo.new(0.2), {
        BackgroundColor3 = GhostOn and Color3.fromRGB(52, 199, 89) or Color3.fromRGB(50, 50, 60),
