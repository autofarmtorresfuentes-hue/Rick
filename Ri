-- Inventory Viewer (BB Hub): iconos de las armas de cada jugador
do
    local BbViewerEnabled = false
    local BbViewerGen = 0
    local BbViewerBillboards = {}
    local BbRarityColors = {
        Common = Color3.fromRGB(255, 255, 255),
        Uncommon = Color3.fromRGB(99, 255, 52),
        Rare = Color3.fromRGB(51, 170, 255),
        Epic = Color3.fromRGB(237, 44, 255),
        Legendary = Color3.fromRGB(255, 150, 0),
        Omega = Color3.fromRGB(255, 20, 51),
    }
    local BbWeaponCache = {}

    local function BbRegisterItems(folder)
        if not folder then
            return
        end

        for _, tool in ipairs(folder:GetChildren()) do
            if tool:IsA('Tool') then
                local handle = tool:FindFirstChild('Handle')
                local displayName = tool:GetAttribute('DisplayName') or tool.Name
                local itemId = tool:GetAttribute('ItemId') or tool:GetAttribute('Id') or tool.Name
                local rarity = tool:GetAttribute('RarityName') or 'Common'
                local imageId = tool:GetAttribute('ImageId') or 'rbxassetid://7072725737'
                local key = nil

                if handle then
                    local mesh = handle:FindFirstChildOfClass('SpecialMesh')

                    if mesh and mesh.MeshId ~= '' then
                        key = mesh.MeshId .. (mesh.TextureId or '') .. '_RARITY_' .. rarity
                    elseif handle:IsA('MeshPart') and handle.MeshId ~= '' then
                        key = handle.MeshId .. (handle.TextureID or '') .. '_RARITY_' .. rarity
                    end
                end

                if not key and itemId and itemId ~= '' and itemId ~= tool.Name then
                    key = 'ITEMID_' .. itemId .. '_RARITY_' .. rarity
                end

                if not key then
                    key = 'NAME_' .. displayName .. '_' .. tool.Name .. '_RARITY_' .. rarity
                end

                BbWeaponCache[key] = {
                    Name = displayName,
                    Rarity = rarity,
                    ImageId = imageId,
                    ToolName = tool.Name,
                }
            end
        end
    end

    local function BbWeaponKey(tool)
        local handle = tool:FindFirstChild('Handle')
        local displayName = tool:GetAttribute('DisplayName') or tool.Name
        local itemId = tool:GetAttribute('ItemId') or tool:GetAttribute('Id') or tool.Name
        local rarity = tool:GetAttribute('RarityName') or 'Common'

        if handle then
            local mesh = handle:FindFirstChildOfClass('SpecialMesh')

            if mesh and mesh.MeshId ~= '' then
                return mesh.MeshId .. (mesh.TextureId or '') .. '_RARITY_' .. rarity
            elseif handle:IsA('MeshPart') and handle.MeshId ~= '' then
                return handle.MeshId .. (handle.TextureID or '') .. '_RARITY_' .. rarity
            end
        end

        if itemId and itemId ~= '' and itemId ~= tool.Name then
            return 'ITEMID_' .. itemId .. '_RARITY_' .. rarity
        end

        return 'NAME_' .. displayName .. '_' .. tool.Name .. '_RARITY_' .. rarity
    end

    local function BbWeaponInfo(tool)
        if not tool or not tool:IsA('Tool') then
            return nil
        end

        return BbWeaponCache[BbWeaponKey(tool)]
    end

    local function BbClearBillboards()
        for _, gui in pairs(BbViewerBillboards) do
            gui:Destroy()
        end

        BbViewerBillboards = {}
    end

    local function BbCreateBillboard(player)
        if not BbViewerEnabled or player == Client then
            return
        end

        local character = player.Character
        local hrp = character and character:FindFirstChild('HumanoidRootPart')

        if not character or not hrp then
            return
        end

        if BbViewerBillboards[player] then
            BbViewerBillboards[player]:Destroy()
            BbViewerBillboards[player] = nil
        end

        local gui = Instance.new('BillboardGui')
        gui.Adornee = hrp
        gui.Size = UDim2.new(0, 90, 0, 20)
        gui.StudsOffset = Vector3.new(0, -5, 0)
        gui.AlwaysOnTop = true

        local layout = Instance.new('UIListLayout')
        layout.FillDirection = Enum.FillDirection.Horizontal
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Padding = UDim.new(0, 5)
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        layout.Parent = gui

        local tools = {}

        for _, name in ipairs({'Backpack', 'StarterGear', 'StarterPack'}) do
            local holder = player:FindFirstChild(name)

            if holder then
                for _, tool in ipairs(holder:GetChildren()) do
                    if tool:IsA('Tool') and tool.Name ~= 'Fists' then
                        table.insert(tools, tool)
                    end
                end
            end
        end

        for _, tool in ipairs(character:GetChildren()) do
            if tool:IsA('Tool') and tool.Name ~= 'Fists' then
                table.insert(tools, tool)
            end
        end

        for _, tool in ipairs(tools) do
            local info = BbWeaponInfo(tool)

            if info then
                local icon = Instance.new('ImageLabel')
                icon.Size = UDim2.new(0, 20, 0, 20)
                icon.BackgroundTransparency = 0.1
                icon.Image = info.ImageId
                icon.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                icon.LayoutOrder = #tools

                local corner = Instance.new('UICorner')
                corner.CornerRadius = UDim.new(0, 5)
                corner.Parent = icon

                local stroke = Instance.new('UIStroke')
                stroke.Color = BbRarityColors[info.Rarity] or Color3.new(1, 1, 1)
                stroke.Thickness = 2
                stroke.Parent = icon

                icon.Parent = gui
            end
        end

        gui.Parent = character
        BbViewerBillboards[player] = gui
    end

    local itemsRoot = ReplicatedStorage:FindFirstChild('Items')

    if itemsRoot then
        for _, sub in ipairs(itemsRoot:GetChildren()) do
            BbRegisterItems(sub)
        end

        itemsRoot.ChildAdded:Connect(function(sub)
            BbRegisterItems(sub)
        end)
    end

    ReplicatedStorage.ChildAdded:Connect(function(child)
        if child.Name == 'Items' then
            for _, sub in ipairs(child:GetChildren()) do
                BbRegisterItems(sub)
            end
        end
    end)

    Players.PlayerRemoving:Connect(function(player)
        if BbViewerBillboards[player] then
            BbViewerBillboards[player]:Destroy()
            BbViewerBillboards[player] = nil
        end
    end)

    VisualTab:Toggle({
        Title = 'Inventory Viewer',
        Desc = 'Muestra las armas de cada jugador (BB Hub)',
        Flag = 'inventoryviewer',
        Icon = 'check',
        Type = 'Checkbox',
        Default = false,
        Callback = function(Value)
            BbViewerEnabled = Value

            if Value then
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= Client and player.Character then
                        BbCreateBillboard(player)
                    end
                end

                BbViewerGen = BbViewerGen + 1
                local myGen = BbViewerGen

                task.spawn(function()
                    while BbViewerEnabled and myGen == BbViewerGen do
                        task.wait(0.25)

                        for _, player in ipairs(Players:GetPlayers()) do
                            if player ~= Client and player.Character then
                                BbCreateBillboard(player)
                            end
                        end
                    end
                end)
            else
                BbViewerGen = BbViewerGen + 1
                BbClearBillboards()
            end
        end,
    })
end


local RunService = game:GetService('RunService')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
