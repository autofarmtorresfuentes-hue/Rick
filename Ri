local function GhostSetNoclip(char, state)
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA('BasePart') then
            if state then
                if GhostCollision[part] == nil then
                    GhostCollision[part] = part.CanCollide
                end

                part.CanCollide = false
            elseif GhostCollision[part] ~= nil then
                pcall(function()
                    part.CanCollide = GhostCollision[part]
                end)

                GhostCollision[part] = nil
            end
        end
    end
end

local function GhostMovement(dt)
    if not GhostOn then
        return
    end

    local char = FloatClient.Character
    local root = char and char:FindFirstChild('HumanoidRootPart')
    local hum = char and char:FindFirstChildOfClass('Humanoid')

    if not char or not root or not hum then
        return
    end

    root.Anchored = true
    GhostSetNoclip(char, true)

    local camera = workspace.CurrentCamera

    if not camera then
        return
    end

    local movement = Vector3.zero
    local amount = 0

    -- el control bruto es lo mas estable en movil; forward sigue la
    -- inclinacion de la camara (si miras abajo y avanzas, bajas)
    if GhostControls then
        local ok, rawMove = pcall(function()
            return GhostControls:GetMoveVector()
        end)

        if ok and typeof(rawMove) == 'Vector3' then
            amount = math.clamp(Vector2.new(rawMove.X, rawMove.Z).Magnitude, 0, 1)

            if amount > 0.01 then
                movement = camera.CFrame.RightVector * rawMove.X
                    + camera.CFrame.LookVector * (-rawMove.Z)
            end
        end
    end

    if movement.Magnitude <= 0.01 and hum.MoveDirection.Magnitude > 0.01 then
        local flatForward = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
        local forwardAmount = 0

        if flatForward.Magnitude > 0.001 then
            forwardAmount = hum.MoveDirection.Unit:Dot(flatForward.Unit)
        end

        movement = Vector3.new(
            hum.MoveDirection.X,
            camera.CFrame.LookVector.Y * forwardAmount,
            hum.MoveDirection.Z
        )
        amount = math.clamp(hum.MoveDirection.Magnitude, 0, 1)
    end

    if movement.Magnitude > 0.01 then
        root.CFrame = root.CFrame
            + movement.Unit * GhostSpeed * math.max(amount, 0.15) * dt
    end
end

local function GhostSetState(state)
    state = state == true

    if state == GhostOn then
        return
    end

    GhostOn = state
    GhostUpdateSwitch()

    local char = FloatClient.Character
    local root = char and char:FindFirstChild('HumanoidRootPart')

    if GhostOn then
        if root then
            GhostWasAnchored = root.Anchored
            root.Anchored = true
        end

        if char then
            GhostSetNoclip(char, true)
        end

        pcall(function()
            GhostControls = require(
                FloatClient:WaitForChild('PlayerScripts'):WaitForChild('PlayerModule')
            ):GetControls()
        end)

        if not GhostConn then
            GhostConn = FloatRunService.RenderStepped:Connect(GhostMovement)
        end
    else
        local current = FloatClient.Character
        local currentRoot = current and current:FindFirstChild('HumanoidRootPart')

        if currentRoot then
            currentRoot.Anchored = GhostWasAnchored == true
        end

        if current then
            GhostSetNoclip(current, false)
        end

        if GhostConn then
            GhostConn:Disconnect()
            GhostConn = nil
        end
    end
end

