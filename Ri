        BackgroundColor3 = Color3.fromRGB(0, 120, 255),
    }):Play()

    FloatTween:Create(TPKnob, TweenInfo.new(0.16), {
        Position = UDim2.new(1, -21, 0.5, -9),
    }):Play()

    local char = FloatClient.Character
    local root = char and char:FindFirstChild('HumanoidRootPart')

    if root then
        local dropped = workspace:FindFirstChild('DroppedItems')

        if dropped then
            local bestPart = nil
            local bestDist = math.huge

            for _, item in ipairs(dropped:GetChildren()) do
                if item:IsA('Model') then
                    local part = item:FindFirstChild('PickUpZone', true)

                    if part and not part:IsA('BasePart') then
                        part = nil
                    end

                    part = part or item.PrimaryPart or item:FindFirstChildWhichIsA('BasePart', true)

                    if part then
                        local dist = (part.Position - root.Position).Magnitude

                        if dist < bestDist then
                            bestPart = part
                            bestDist = dist
                        end
                    end
                end
            end

            if bestPart then
                local delta = bestPart.Position - root.Position

                if delta.Magnitude > 0.1 then
                    local power = math.clamp(bestDist * 2.1, 105, 225)

                    root.AssemblyLinearVelocity = delta.Unit * power + Vector3.new(0, 48, 0)
                    root.AssemblyAngularVelocity = Vector3.new(5, 0, 4)
                end
            end
        end
    end

    task.delay(0.42, function()
        if TPSwitchBg and TPSwitchBg.Parent then
            FloatTween:Create(TPSwitchBg, TweenInfo.new(0.16), {
                BackgroundColor3 = Color3.fromRGB(32, 35, 45),
            }):Play()

            FloatTween:Create(TPKnob, TweenInfo.new(0.16), {
                Position = UDim2.new(0, 3, 0.5, -9),
            }):Play()
        end
    end)
end)

end
