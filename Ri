task.spawn(function()
    local UserInputService = game:GetService('UserInputService')
    local SendRemote = game:GetService('ReplicatedStorage').Remotes.Send

    local IsMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

    local SilentOn = false
    local LineLockOn = false
    local BbFovRadius = 120
    local BbTarget = nil

    -- lista de Safe Friends compartida con el ESP y con Combat
    _G.MontanaSafeList = _G.MontanaSafeList or {}

    local BbExcluded = _G.MontanaSafeList
    local BbSmoothPos = Vector3.zero
    local BbLerpAlpha = 0.35

    local BbVelHistory = {}
    local BbVelMaxSamples = 8

    local BbPingHistory = {}
    local BbPingMax = 10

    local BbCircle = nil
    local BbCircleFrame = nil
    local BbLine = nil
    local BbBox = nil

    local function BbGetSmoothedPing()
        local ok, value = pcall(function()
            return game:GetService('Stats').Network.ServerStatsItem['Data Ping']:GetValue()
        end)

        if not ok or typeof(value) ~= 'number' then
            return 0.2
        end

        table.insert(BbPingHistory, value)

        if #BbPingHistory > BbPingMax then
            table.remove(BbPingHistory, 1)
        end

        local sum = 0

        for _, v in ipairs(BbPingHistory) do
            sum = sum + v
        end

        return (sum / #BbPingHistory) / 1000
    end

    local function BbIsExcluded(name)
        for _, pattern in ipairs(BbExcluded) do
            if pattern ~= '' and string.find(string.lower(name), string.lower(pattern), 1, true) then
                return true
            end
        end

        return false
    end

    local function BbGetClosestTarget()
        local closest = nil
        local shortest = BbFovRadius
        local camera = workspace.CurrentCamera
        local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= Client and player.Character then
                local char = player.Character
                local head = char:FindFirstChild('Head')
                local hum = char:FindFirstChildOfClass('Humanoid')

                if head and hum and hum.Health > 0 then
                    local pos, onScreen = camera:WorldToViewportPoint(head.Position)

                    if onScreen then
                        local screenPos = Vector2.new(pos.X, pos.Y)
                        local dist = (screenPos - center).Magnitude

                        if dist <= BbFovRadius and not BbIsExcluded(player.Name) then
                            if dist < shortest then
                                shortest = dist
                                closest = player
                            end
                        end
                    end
                end
            end
        end

        return closest
    end

    local function BbCalculateVelocity(player)
        local history = BbVelHistory[player]

        if not history or #history < 2 then
            return Vector3.zero
        end

        local sum = Vector3.zero
        local count = 0

        for i = 2, #history do
            local dt = history[i].time - history[i - 1].time

            if dt > 0 then
                sum = sum + (history[i].pos - history[i - 1].pos) / dt
                count = count + 1
            end
        end

        if count == 0 then
            return Vector3.zero
        end

        return sum / count
    end

    local function BbPredictPosition(targetPart, character)
        if not targetPart then
            return Vector3.zero
        end

        local player = Players:GetPlayerFromCharacter(character)

        if not player then
            return targetPart.Position
        end

        local velocity = BbCalculateVelocity(player)
        local ping = BbGetSmoothedPing()

        return targetPart.Position + velocity * ping
    end

    local function BbIsBehindWall(fromPos, toPos)
        if not fromPos then
            return false
        end

        local delta = toPos - fromPos

        if delta.Magnitude < 1 then
            return false
        end

        local ignore = {}
        local myChar = Client.Character

        if myChar then
            table.insert(ignore, myChar)
        end

        if BbTarget and BbTarget.Character then
            table.insert(ignore, BbTarget.Character)
        end

        local result = workspace:Raycast(fromPos, delta, RaycastParams.new())

        if not result then
            return false
        end

        return result.Instance and not table.find(ignore, result.Instance.Parent)
    end

    local function BbIsShotgun()
        local char = Client.Character

        if not char then
            return false
        end

        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA('Tool') then
                local ammoType = tool:GetAttribute('AmmoType')

                if ammoType == 'shotgun' or ammoType == 'shootgun' then
                    return true
                end
            end
        end

        return false
    end

    -- historial de velocidad de cada jugador (para la prediccion)
    RunService.Heartbeat:Connect(function()
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= Client and player.Character then
                local char = player.Character
                local hrp = char:FindFirstChild('HumanoidRootPart')
                local hum = char:FindFirstChildOfClass('Humanoid')

                if hrp and hum and hum.Health > 0 then
                    BbVelHistory[player] = BbVelHistory[player] or {}
                    table.insert(BbVelHistory[player], { time = os.clock(), pos = hrp.Position })

                    if #BbVelHistory[player] > BbVelMaxSamples then
                        table.remove(BbVelHistory[player], 1)
                    end
                else
                    BbVelHistory[player] = nil
                end
            end
        end
    end)

    Players.PlayerRemoving:Connect(function(player)
        BbVelHistory[player] = nil
    end)

    -- el disparo sale hacia la cabeza del objetivo, con prediccion de
    -- velocidad y ping; escopeta = 8 postas; tras pared no se desvia
    local bbOldFire

    bbOldFire = hookfunction(SendRemote.FireServer, function(self, ...)
        if self ~= SendRemote then
            return bbOldFire(self, ...)
        end

        local args = { ... }

        if SilentOn and args[2] == 'shoot_gun' and BbTarget and BbTarget.Character and not _G.MontanaAutoShootSending then
            local targetChar = BbTarget.Character
            local head = targetChar:FindFirstChild('Head')
            local hrp = targetChar:FindFirstChild('HumanoidRootPart')
            local hum = targetChar:FindFirstChildOfClass('Humanoid')

            if head and hrp and hum then
                local aimPos = BbPredictPosition(head, targetChar)
                local myHead = Client.Character and Client.Character:FindFirstChild('Head')
                local myPos = myHead and myHead.Position or nil

                if myPos then
                    if BbIsShotgun() then
                        args[4] = CFrame.new(myPos, aimPos)

                        local pellets = {}

                        for i = 1, 8 do
                            local offset = Vector3.new(
                                math.random(-2, 2) * 0.03,
                                math.random(-2, 2) * 0.03,
                                math.random(-2, 2) * 0.03
                            )

                            table.insert(pellets, {
                                [1] = {
                                    Instance = head,
                                    Normal = Vector3.new(0, 1, 0),
                                    Position = aimPos + offset,
                                },
                            })
                        end

                        args[5] = pellets
                    else
                        if BbIsBehindWall(myPos, aimPos) then
                            args[4] = CFrame.new(math.huge, math.huge, math.huge)
                        else
                            args[4] = CFrame.new(myPos, aimPos)
                        end

                        args[5] = {
                            [1] = {
                                [1] = {
                                    Instance = head,
                                    Normal = Vector3.new(0, 1, 0),
                                    Position = aimPos,
                                },
                            },
                        }
                    end

                    -- linea roja del disparo (BB Hub): se pone verde si le diste
                    local beam = nil

                    pcall(function()
                        beam = Instance.new('Part')
                        beam.Anchored = true
                        beam.CanCollide = false
                        beam.Size = Vector3.new(0.08, 0.08, (aimPos - myPos).Magnitude)
                        beam.CFrame = CFrame.new(myPos, aimPos) * CFrame.new(0, 0, -beam.Size.Z / 2)
                        beam.Material = Enum.Material.Neon
                        beam.Transparency = 0.35
                        beam.Color = Color3.fromRGB(255, 0, 0)
                        beam.Parent = workspace

                        game:GetService('Debris'):AddItem(beam, 4)
                    end)

                    local healthBefore = hum.Health

                    task.delay(0.1, function()
                        if beam and hum and hum.Parent and hum.Health < healthBefore then
                            beam.Color = Color3.fromRGB(0, 255, 0)
                        end
                    end)
                end
            end
        end

        return bbOldFire(self, unpack(args))
    end)

    -- circulo FOV + linea al objetivo + marco (Line Lock)
    local function BbEnsureDrawings()
        if BbCircle or BbCircleFrame then
            return
        end

        pcall(function()
            if IsMobile then
                local gui = Instance.new('ScreenGui')
                gui.Name = 'BBSilentFov'
                gui.IgnoreGuiInset = true
                gui.ResetOnSpawn = false
                gui.Parent = game:GetService('CoreGui')

                BbCircleFrame = Instance.new('Frame')
                BbCircleFrame.AnchorPoint = Vector2.new(0.5, 0.5)
                BbCircleFrame.Position = UDim2.fromScale(0.5, 0.5)
                BbCircleFrame.BackgroundTransparency = 1
                BbCircleFrame.Size = UDim2.fromOffset(BbFovRadius * 2, BbFovRadius * 2)
                BbCircleFrame.Visible = false

                local stroke = Instance.new('UIStroke')
                stroke.Color = Color3.fromRGB(255, 255, 255)
                stroke.Thickness = 2
                stroke.Parent = BbCircleFrame

                local corner = Instance.new('UICorner')
                corner.CornerRadius = UDim.new(1, 0)
                corner.Parent = BbCircleFrame

                BbCircleFrame.Parent = gui
            else
                BbCircle = Drawing.new('Circle')
                BbCircle.Thickness = 1.5
                BbCircle.Color = Color3.fromRGB(255, 255, 255)
                BbCircle.NumSides = 60
                BbCircle.Filled = false
                BbCircle.Visible = false
            end

            BbLine = Drawing.new('Line')
            BbLine.Thickness = 1.3
            BbLine.Color = Color3.fromRGB(255, 50, 50)
            BbLine.Transparency = 1
            BbLine.Visible = false

            BbBox = {}

            for i = 1, 4 do
                BbBox[i] = Drawing.new('Line')
                BbBox[i].Color = Color3.fromRGB(255, 255, 255)
                BbBox[i].Thickness = 1.2
                BbBox[i].Visible = false
            end
        end)
    end

    local function BbHideAimVisuals()
        if BbLine then
            BbLine.Visible = false
        end

        if BbBox then
            for i = 1, 4 do
                BbBox[i].Visible = false
            end
        end
    end

    RunService.RenderStepped:Connect(function()
        pcall(function()
            BbTarget = (SilentOn or LineLockOn) and BbGetClosestTarget() or nil

            BbEnsureDrawings()

            -- circulo FOV: se re-asegura cada frame, no se quita al morir
            if IsMobile then
                if BbCircleFrame then
                    BbCircleFrame.Visible = SilentOn
                    BbCircleFrame.Size = UDim2.fromOffset(BbFovRadius * 2, BbFovRadius * 2)
                end
            elseif BbCircle then
                BbCircle.Visible = SilentOn

                if SilentOn then
                    local camera = workspace.CurrentCamera

                    BbCircle.Position = Vector2.new(
                        camera.ViewportSize.X / 2,
                        camera.ViewportSize.Y / 2
                    )
                    BbCircle.Radius = BbFovRadius
                end
            end

            -- Line Lock (Línea): linea roja del centro al objetivo + marco
            if not (BbLine and BbBox) then
                return
            end

            if BbTarget and BbTarget.Character then
                local char = BbTarget.Character
                local hum = char:FindFirstChildOfClass('Humanoid')
                local head = char:FindFirstChild('Head')

                if hum and hum.Health > 0 and head then
                    local camera = workspace.CurrentCamera

                    BbSmoothPos = BbSmoothPos:Lerp(head.Position, BbLerpAlpha)

                    local pos, onScreen = camera:WorldToViewportPoint(BbSmoothPos)

                    if onScreen then
                        BbLine.Visible = true
                        BbLine.From = Vector2.new(
                            camera.ViewportSize.X / 2,
                            camera.ViewportSize.Y / 2
                        )
                        BbLine.To = Vector2.new(pos.X, pos.Y)

                        local top = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                        local bottom = camera:WorldToViewportPoint(head.Position - Vector3.new(0, 0.5, 0))
                        local mid = Vector2.new(pos.X, pos.Y)
                        local half = math.clamp((top - bottom).Magnitude / 2, 8, 25)

                        BbBox[1].From, BbBox[1].To = Vector2.new(mid.X, mid.Y - half), Vector2.new(mid.X + half, mid.Y)
                        BbBox[2].From, BbBox[2].To = Vector2.new(mid.X + half, mid.Y), Vector2.new(mid.X, mid.Y + half)
                        BbBox[3].From, BbBox[3].To = Vector2.new(mid.X, mid.Y + half), Vector2.new(mid.X - half, mid.Y)
                        BbBox[4].From, BbBox[4].To = Vector2.new(mid.X - half, mid.Y), Vector2.new(mid.X, mid.Y - half)

                        for i = 1, 4 do
                            BbBox[i].Visible = true
                        end

                        return
                    end
                end
            end

            BbHideAimVisuals()

            if not BbTarget then
                BbSmoothPos = Vector3.zero
            end
        end)
    end)

    CombatTab:Toggle({
        Title = 'Silent Aim',
        
        Desc = 'Redirects your gun shots to the locked enemy automatically',
        Flag = 'bb_silent_aim',
        Icon = 'check',
        Type = 'Checkbox',
        Default = false,
        Callback = function(state)
            SilentOn = state
            BbTarget = nil
        end,
    })

    CombatTab:Toggle({
        Title = 'Línea',
        
        Desc = 'Draws a line to the enemy locked by Silent Aim',
        Flag = 'bb_line_lock',
        Icon = 'check',
        Type = 'Checkbox',
        Default = false,
        Callback = function(state)
            LineLockOn = state
            BbTarget = nil
        end,
    })

    CombatTab:Slider({
        Title = 'FOV',

        Desc = 'Size of the circle that decides who Silent Aim can lock',
        Flag = 'bb_fov_radius',
        Step = 1,
        Value = {
            Min = 20,
            Max = 800,
            Default = 120,
        },
        Callback = function(value)
            BbFovRadius = tonumber(value) or 120
        end,
    })

    local function BbSafeBuildList()
        local list = {}

        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= Client then
                table.insert(list, pl.Name)
            end
        end

        return list
    end

    local BbSafeDropdown

    local function BbSafeRefresh()
        pcall(function()
            BbSafeDropdown:Refresh(BbSafeBuildList())
        end)
    end

    CombatTab:Section({
        Title = 'Safe Friends:',
    })

    BbSafeDropdown = CombatTab:Dropdown({
        Title = 'Safe Friend Select',

        Desc = 'Tap a player to make them a Safe Friend; tap again to undo it',
        Values = BbSafeBuildList(),
        Callback = function(value)
            local name = tostring(value or '')

            if name == '' then
                return
            end

            local exists = false

            for _, pl in ipairs(Players:GetPlayers()) do
                if pl.Name == name then
                    exists = true
                    break
                end
            end

            if not exists then
                return
            end

            if BbIsExcluded(name) then
                for i, existing in ipairs(BbExcluded) do
                    if existing == name then
                        table.remove(BbExcluded, i)
                        break
                    end
                end
            else
                table.insert(BbExcluded, name)
            end
        end,
    })

    CombatTab:Button({
        Title = 'Refresh Users',
        
        Desc = 'Refreshes the player list shown in Safe Friend Select',
        Callback = function()
            BbSafeRefresh()
        end,
    })

    Players.PlayerAdded:Connect(function()
        task.wait(0.5)
        BbSafeRefresh()
    end)

    Players.PlayerRemoving:Connect(function()
        task.wait(0.5)
        BbSafeRefresh()
    end)
end)

do
-- Auto Shoot (ChinoInfierno V3) + Speed Shoot
-- - Auto Shoot: el auto target vive SOLO aqui; dispara al enemigo
--   vivo mas cercano (sin ser Safe Friend, con linea de tiro y a
--   menos de 90 m ~ 321 studs) con el ritmo del arma.
-- - Speed Shoot: cada disparo MANUAL sale multiplicado (si pones 2,
--   hacen dos disparos; si pones 3, tres, y asi).
local AutShootPlayers = game:GetService('Players')
local AutShootRunService = game:GetService('RunService')
local AutShootClient = AutShootPlayers.LocalPlayer
local AutShootNet = require(game:GetService('ReplicatedStorage').Modules.Core.Net)
local AutShootSendRemote = game:GetService('ReplicatedStorage').Remotes.Send

_G.MontanaSafeList = _G.MontanaSafeList or {}

local AutoShootOn = false
local AutoShootLast = 0
local AutoShootInterval = 0.25
local SpeedShootOn = false
local SpeedShootCount = 2

local function AutShootIsSafe(name)
    name = string.lower(tostring(name or ''))

    for _, pattern in ipairs(_G.MontanaSafeList) do
        if pattern ~= '' and string.find(name, string.lower(pattern), 1, true) then
            return true
        end
    end

    return false
end

local function AutShootFindTarget(char, head)
    local bestHead = nil
    local bestChar = nil
    local bestDist = 321

    for _, pl in ipairs(AutShootPlayers:GetPlayers()) do
        if pl ~= AutShootClient and pl.Character and not AutShootIsSafe(pl.Name) then
            local tChar = pl.Character
            local tHead = tChar:FindFirstChild('Head')
            local tRoot = tChar:FindFirstChild('HumanoidRootPart')
            local tHum = tChar:FindFirstChildOfClass('Humanoid')

            if tHead and tRoot and tHum and tHum.Health > 0 then
                local dist = (tHead.Position - head.Position).Magnitude

                if dist < bestDist then
                    bestHead = tHead
                    bestChar = tChar
                    bestDist = dist
                end
            end
        end
    end

    if bestHead and bestChar then
        local params = RaycastParams.new()

        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { char, bestChar }

        local hit = workspace:Raycast(head.Position, bestHead.Position - head.Position, params)

        if hit then
            return nil
        end
    end

    return bestHead
end

AutShootRunService.Heartbeat:Connect(function()
    if not AutoShootOn then
        return
    end

    local now = os.clock()

    if now - AutoShootLast < AutoShootInterval then
        return
    end

    local char = AutShootClient.Character
    local head = char and char:FindFirstChild('Head')
    local gun = char and char:FindFirstChildOfClass('Tool')

    if not char or not head or not gun or gun.Name == 'Fists' then
        return
    end

    local targetHead = AutShootFindTarget(char, head)

    if not targetHead then
        return
    end

    AutoShootLast = now

    _G.MontanaAutoShootSending = true

    pcall(function()
        AutShootNet.send('shoot_gun', gun, CFrame.new(head.Position, targetHead.Position), {
            [1] = {
                {
                    Instance = targetHead,
                    Normal = Vector3.new(0, 1, 0),
                    Position = targetHead.Position,
                },
            },
        })
    end)

    _G.MontanaAutoShootSending = nil
end)

local oldSpeedFire

oldSpeedFire = hookfunction(AutShootSendRemote.FireServer, function(self, ...)
    if self ~= AutShootSendRemote then
        return oldSpeedFire(self, ...)
    end

    local args = { ... }
    local isShot = args[2] == 'shoot_gun'
    local result = oldSpeedFire(self, ...)

    -- Speed Shoot: solo multiplica los disparos manuales, nunca los
    -- que manda el Auto Shoot ni los duplicados de antes.
    if isShot and SpeedShootOn and SpeedShootCount > 1 and not _G.MontanaAutoShootSending and not _G.MontanaSpeedShootSending then
        _G.MontanaSpeedShootSending = true

        for _ = 2, SpeedShootCount do
            pcall(function()
                oldSpeedFire(self, unpack(args))
            end)
        end

        _G.MontanaSpeedShootSending = nil
    end

    return result
end)

CombatTab:Toggle({
    Title = 'Auto Shoot',
    
    Desc = 'Automatically shoots the closest valid enemy; the auto target is built into this option',
    Flag = 'auto_shoot',
    Icon = 'check',
    Type = 'Checkbox',
    Default = false,
    Callback = function(state)
        AutoShootOn = state
        AutoShootLast = 0
    end,
})

CombatTab:Toggle({
    Title = 'Speed Shoot',
    
    Desc = 'Fires extra shots every time you shoot manually',
    Flag = 'speed_shoot',
    Icon = 'check',
    Type = 'Checkbox',
    Default = false,
    Callback = function(state)
        SpeedShootOn = state
    end,
})

CombatTab:Slider({
    Title = 'Disparos por gatillo',

    Desc = 'Number of shots per trigger pull: 2 = two shots, 3 = three',
    Flag = 'speed_shoot_count',
    Step = 1,
    Value = {
        Min = 2,
        Max = 8,
        Default = 2,
    },
    Callback = function(value)
        SpeedShootCount = math.max(2, math.floor(tonumber(value) or 2))
    end,
})


end

local Camera = workspace.CurrentCamera

local FakeHead = nil

local function UpdateFakeHead()
    if not _G.AntiLock then
        if FakeHead then
            FakeHead:Destroy()

            FakeHead = nil
        end

        return
    end

    local char = LocalPlayer.Character

    if not char then
        return
    end

    local realHead = char:FindFirstChild('Head')

    if not realHead then
        return
    end
    if not FakeHead or not FakeHead.Parent then
        FakeHead = Instance.new('Part')
        FakeHead.Name = 'FakeHead'
        FakeHead.Size = Vector3.new(2, 1, 1)
        FakeHead.Transparency = 1
        FakeHead.CanCollide = false
        FakeHead.Anchored = true
        FakeHead.Parent = workspace
    end

    local camera = workspace.CurrentCamera

    if camera then
        FakeHead.CFrame = camera.CFrame * CFrame.new(0, 0, -5)
    end
end

LocalPlayer.CharacterRemoving:Connect(function()
    if FakeHead then
        FakeHead:Destroy()

        FakeHead = nil
    end
end)
RunService.Heartbeat:Connect(function()
    UpdateFakeHead()
end)








local function GetDistanceFromRootPart(targetRoot)
    if not targetRoot or not RootPart then
        return math.huge
    end

    return (RootPart.Position - targetRoot.Position).Magnitude
end



do

-- ===========================================================
-- Auto Attack + Melee Aura (traidos de PROMETHEUS)
-- - Auto Attack: golpea solo al jugador mas cercano con
--   Fists o cualquier herramienta melee, auto-equipandola.
-- - Melee Aura: modifica los atributos 6 y 7 (ordenados) de
--   Fists y de las herramientas melee a 360 y 20; al apagar
--   restaura los valores originales.
-- - Los Safe Friend (lista compartida del Silent Aim) nunca
--   son golpeados por el Auto Attack.
-- ===========================================================
_G.MontanaSafeList = _G.MontanaSafeList or {}

_G.IsSafeFriend = _G.IsSafeFriend or function(name)
    name = string.lower(tostring(name or ''))

    for _, pattern in ipairs(_G.MontanaSafeList) do
        if pattern ~= '' and string.find(name, string.lower(pattern), 1, true) then
            return true
        end
    end

    return false
end

local PromeAutoAttackEnabled = false
local PromeMeleeAuraEnabled = false
local PromeLastAutoAttack = 0
local PromeSavedToolAttrs = {}
local PromeMeleeList = {}

do
    local itemsFolder = ReplicatedStorage:FindFirstChild('Items')

    if itemsFolder then
        local meleeFolder = itemsFolder:FindFirstChild('melee')

        if meleeFolder then
            for _, toolItem in ipairs(meleeFolder:GetChildren()) do
                table.insert(PromeMeleeList, toolItem.Name)
            end
        end
    end
end

local function PromeIsMeleeTool(tool)
    if not tool:IsA('Tool') then
        return false
    end

    if tool.Name == 'Fists' then
        return true
    end

    for _, toolName in ipairs(PromeMeleeList) do
        if tool.Name == toolName then
            return true
        end
    end

    return false
end

local function PromeModifyTool(tool, enable)
    local attrNames = {}

    for attrName in pairs(tool:GetAttributes()) do
        table.insert(attrNames, attrName)
    end

    table.sort(attrNames)

    if #attrNames < 7 then
        return
    end

    local attr6 = attrNames[6]
    local attr7 = attrNames[7]

    if enable then
        if PromeSavedToolAttrs[tool] == nil then
            PromeSavedToolAttrs[tool] = {}
        end

        -- false = el atributo no existia y hay que borrarlo al restaurar
        if PromeSavedToolAttrs[tool][attr6] == nil then
            PromeSavedToolAttrs[tool][attr6] = tool:GetAttribute(attr6) or false
        end

        if PromeSavedToolAttrs[tool][attr7] == nil then
            PromeSavedToolAttrs[tool][attr7] = tool:GetAttribute(attr7) or false
        end

        tool:SetAttribute(attr6, 360)
        tool:SetAttribute(attr7, 20)
    else
        local saved = PromeSavedToolAttrs[tool]

